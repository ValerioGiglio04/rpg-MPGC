<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" maxWidth="620.0" spacing="24.0" styleClass="game-root,theme-duel,menu-screen" stylesheets="@../styles/game.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="42.0" left="24.0" right="24.0" top="42.0" />
    </padding>

    <Label styleClass="game-title" text="%victory.screen.title" />
    <Label styleClass="game-subtitle" text="%victory.screen.subtitle" />

    <VBox alignment="CENTER" maxWidth="620.0" spacing="14.0" styleClass="game-panel-highlight,menu-panel">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </padding>
        <Label styleClass="panel-title" text="%victory.panel.title" />
        <Label fx:id="scoreLabel" styleClass="game-label" text="%victory.score.placeholder" />
        <VBox alignment="CENTER" maxWidth="280.0" spacing="14.0" styleClass="action-list">
            <Button fx:id="newRunButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="game-button" text="%menu.start" />
            <Button fx:id="menuButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="game-button,secondary-button" text="%menu.back" />
        </VBox>
    </VBox>

    <Label styleClass="muted-label" text="%victory.footer.hint" />
</VBox>
