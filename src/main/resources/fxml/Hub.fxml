<?xml version="1.0" encoding="UTF-8"?>

<?import it.unicam.cs.mpgc.rpg125664.view.component.HamburgerMenu?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="game-root,theme-duel,hub-screen" stylesheets="@../styles/game.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="26.0" left="26.0" right="26.0" top="26.0" />
    </padding>
    <top>
        <BorderPane>
            <BorderPane.margin>
                <Insets bottom="18.0" />
            </BorderPane.margin>
            <left>
                <Region minWidth="48.0" prefWidth="48.0" />
            </left>
            <center>
                <HBox alignment="CENTER" spacing="16.0">
                    <StackPane fx:id="portraitHost" />
                    <VBox alignment="CENTER_LEFT" spacing="6.0">
                        <Label styleClass="game-title" text="%hub.screen.title" />
                        <Label fx:id="subtitleLabel" styleClass="game-subtitle" />
                    </VBox>
                </HBox>
            </center>
            <right>
                <HamburgerMenu fx:id="hamburgerMenu" styleClass="hamburger-menu" BorderPane.alignment="TOP_RIGHT" />
            </right>
        </BorderPane>
    </top>
    <left>
        <VBox maxHeight="1.7976931348623157E308" spacing="12.0" styleClass="game-panel">
            <BorderPane.margin>
                <Insets right="18.0" />
            </BorderPane.margin>
            <Label styleClass="panel-title" text="%hub.panel.team" />
            <ScrollPane fitToWidth="true" maxHeight="1.7976931348623157E308" pannable="true" styleClass="game-scroll" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                <VBox fx:id="teamList" spacing="12.0">
                    <padding>
                        <Insets bottom="0.0" left="0.0" right="8.0" top="0.0" />
                    </padding>
                </VBox>
            </ScrollPane>
        </VBox>
    </left>
    <center>
        <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" spacing="12.0" styleClass="game-panel-highlight,hub-center-panel">
            <Label styleClass="panel-title" text="%hub.panel.map" />
            <StackPane fx:id="mapContentHost" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" VBox.vgrow="ALWAYS" />
        </VBox>
    </center>
</BorderPane>
