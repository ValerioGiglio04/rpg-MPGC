<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" maxWidth="560.0" spacing="24.0" styleClass="game-root,theme-duel,menu-screen" stylesheets="@../styles/game.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="42.0" left="24.0" right="24.0" top="42.0" />
    </padding>

    <Label styleClass="game-title" text="%load.screen.title" />
    <Label styleClass="game-subtitle" text="%load.screen.subtitle" />

    <VBox alignment="CENTER" maxWidth="520.0" spacing="14.0" styleClass="game-panel-highlight,menu-panel">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </padding>
        <Label styleClass="panel-title" text="%load.screen.list.title" />
        <ListView fx:id="savesList" maxHeight="280.0" prefHeight="280.0" styleClass="load-saves-list" />
        <VBox alignment="CENTER" maxWidth="320.0" spacing="14.0" styleClass="action-list">
            <Button fx:id="loadButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="game-button" text="%load.screen.load" />
            <Button fx:id="deleteButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="game-button,danger-button" text="%load.screen.delete" />
            <Button fx:id="backButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="game-button,secondary-button" text="%menu.back" />
        </VBox>
    </VBox>
</VBox>
